#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT_DIR"

fail() {
  printf 'doctor: %s\n' "$1" >&2
  exit 1
}

need_file() {
  [ -f "$1" ] || fail "missing required file: $1"
}

need_dir() {
  [ -d "$1" ] || fail "missing required directory: $1"
}

need_file AGENTS.md
need_file README.md
need_file .copier-answers.yml
need_file docs/README.md
need_file docs/approach.md
need_file docs/product-intent.md
need_file docs/records/README.md
need_dir docs/records

if grep -RIn --exclude='.copier-answers.yml' --exclude-dir='.git' '{% raw %}{{\|}}\|{%\|%}{% endraw %}' AGENTS.md README.md docs >/tmp/agentic-template-unrendered.$$ 2>/dev/null; then
  cat /tmp/agentic-template-unrendered.$$
  rm -f /tmp/agentic-template-unrendered.$$
  fail "found unrendered template markers"
fi
rm -f /tmp/agentic-template-unrendered.$$

if ! grep -q '_src_path:' .copier-answers.yml; then
  fail ".copier-answers.yml is missing _src_path"
fi

if ! grep -q 'Autonomous coding agents are trusted collaborators' AGENTS.md; then
  fail "AGENTS.md is missing the high-agency guidance"
fi

if ! grep -q '## Role' AGENTS.md; then
  fail "AGENTS.md is missing coding-agent role guidance"
fi

if ! grep -q 'Language And Tooling Guidance' AGENTS.md; then
  fail "AGENTS.md is missing the language and tooling guidance"
fi

if ! grep -q 'Forward Operating Model' AGENTS.md; then
  fail "AGENTS.md is missing the forward operating model guidance"
fi

if ! grep -q 'Where Work Belongs' AGENTS.md; then
  fail "AGENTS.md is missing placement guidance"
fi

if ! grep -q 'Feature Work' AGENTS.md; then
  fail "AGENTS.md is missing feature work guidance"
fi

if ! grep -q 'Verification' AGENTS.md; then
  fail "AGENTS.md is missing verification guidance"
fi

if ! grep -q 'Agentic Delivery Model' README.md; then
  fail "README.md is missing the agentic delivery model"
fi

if ! grep -q 'Project Approach' docs/approach.md; then
  fail "approach doc is missing the expected title"
fi

if ! grep -q 'current project truth' docs/approach.md; then
  fail "approach doc is missing current-truth guidance"
fi

if ! grep -q 'Current Stack' docs/approach.md; then
  fail "approach doc is missing stack guidance"
fi

if ! grep -q 'Operating Model' docs/approach.md; then
  fail "approach doc is missing operating model guidance"
fi

if ! grep -q 'Project Records' docs/records/README.md; then
  fail "project records guide is missing the expected title"
fi

if ! grep -q 'one standard way to document' docs/records/README.md; then
  fail "project records guide is missing the single-record-system guidance"
fi

if ! grep -q 'Documentation Map' AGENTS.md; then
  fail "AGENTS.md is missing the documentation map"
fi

if ! grep -q 'docs/approach.md' AGENTS.md; then
  fail "AGENTS.md is missing approach guidance"
fi

if ! grep -q 'docs/product-intent.md' AGENTS.md; then
  fail "AGENTS.md is missing product-intent guidance"
fi

if ! grep -q 'Evidence And Verification' AGENTS.md; then
  fail "AGENTS.md is missing evidence and verification guidance"
fi

if ! grep -q 'Instruction Mode And Edit Contract' AGENTS.md; then
  fail "AGENTS.md is missing request interpretation guidance"
fi

if ! grep -q 'Manual verification matters' AGENTS.md; then
  fail "AGENTS.md is missing manual verification guidance"
fi

if ! grep -q 'first-class changes' AGENTS.md; then
  fail "AGENTS.md is missing first-class change guidance"
fi

if ! grep -q 'Failure Behavior' AGENTS.md; then
  fail "AGENTS.md is missing failure behavior guidance"
fi

if grep -RIn --exclude-dir='.git' --exclude='.copier-answers.yml' 'runtime-agent\|agentic-runtime\|llm-outputs\|ToolProposal\|prompt injection' AGENTS.md README.md docs >/tmp/agentic-template-runtime.$$ 2>/dev/null; then
  cat /tmp/agentic-template-runtime.$$
  rm -f /tmp/agentic-template-runtime.$$
  fail "found removed application-agent guidance in generated docs"
fi
rm -f /tmp/agentic-template-runtime.$$

printf 'doctor: ok\n'
